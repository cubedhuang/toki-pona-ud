{
	"extends": "@tsconfig/svelte/tsconfig.json",
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"customConditions": ["source"],
		"types": ["svelte", "vite/client"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
