{
	"name": "ilo-nasin",
	"version": "1.0.1",
	"author": "cubedhuang <99danielh@gmail.com> (https://dan.onl)",
	"description": "A parser and part-of-speech tagger for Toki Pona.",
	"license": "MIT",
	"keywords": [
		"toki pona",
		"parser",
		"context-free grammar",
		"part-of-speech tagging"
	],
	"repository": "github:cubedhuang/ilo-nasin",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"type": "module",
	"scripts": {
		"build": "pnpm codegen && tsc",
		"codegen": "esr scripts/expand-generics.ts src/grammar.ne src/grammar.expanded.ne && nearleyc src/grammar.expanded.ne -o src/grammar.js",
		"format": "prettier --write ."
	},
	"dependencies": {
		"nearley": "^2.20.1"
	},
	"devDependencies": {
		"@types/nearley": "^2.11.5",
		"@types/node": "^24.6.1",
		"esbuild-runner": "^2.2.2",
		"prettier": "^3.6.2",
		"typescript": "^5.9.3"
	}
}
